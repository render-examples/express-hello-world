# Server configuration — never expose service role keys or provider secrets in frontend code.
PORT=3000
APP_ORIGIN=http://localhost:3000

# Supabase: Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# OpenAI: create a server-side API key
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Paddle Billing — choose sandbox until seller account and products are approved
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_STARTER_PRICE_ID=
PADDLE_PRO_PRICE_ID=
PADDLE_BUSINESS_PRICE_ID=
